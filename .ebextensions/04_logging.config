files:
  "/tmp/amazon-cloudwatch-agent.json":
    mode: "000644"
    owner: root
    group: root
    content: |
      {
        "agent": {
          "run_as_user": "root"
        },
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
                {
                  "file_path": "/var/log/tomcat9/flights*.log*",
                  "log_group_name": "/aws/elasticbeanstalk/ieagle/prod/flights.log",
                  "log_stream_name": "{instance_id}"
                },
                {
                  "file_path": "/var/log/tomcat9/flightNotFoundRQRS*.log*",
                  "log_group_name": "/aws/elasticbeanstalk/ieagle/prod/flightNotFoundRQRS.log",
                  "log_stream_name": "{instance_id}"
                },
                {
                  "file_path": "/var/log/tomcat9/flightsSearchError*.log*",
                  "log_group_name": "/aws/elasticbeanstalk/ieagle/prod/flightsSearchError.log",
                  "log_stream_name": "{instance_id}"
                },
                {
                  "file_path": "/var/log/tomcat9/resultNotDefined*.log*",
                  "log_group_name": "/aws/elasticbeanstalk/ieagle/prod/resultNotDefined.log",
                  "log_stream_name": "{instance_id}"
                },
                {
                  "file_path": "/var/log/tomcat9/localhost_access_log*.txt*",
                  "log_group_name": "/aws/elasticbeanstalk/ieagle/prod/localhost_access_log",
                  "log_stream_name": "{instance_id}"
                },
                {
                  "file_path": "/var/log/tomcat9/mobileScriptError*.log*",
                  "log_group_name": "/aws/elasticbeanstalk/ieagle/prod/mobileScriptError.log",
                  "log_stream_name": "{instance_id}"
                },
                {
                  "file_path": "/var/log/httpd/access*log*",
                  "log_group_name": "/aws/elasticbeanstalk/ieagle/prod/webserver/access_log",
                  "log_stream_name": "{instance_id}"
                }
              ]
            }
          }
        }
      }
  "/etc/systemd/system/amazon-cloudwatch-agent.service.d/zz-detach-from-eb.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      PartOf=

commands:
  01_install_cloudwatch_agent:
    command: "dnf install -y amazon-cloudwatch-agent"
    ignoreErrors: "false"

  02_prepare_systemd_dropin_dir:
    command: "mkdir -p /etc/systemd/system/amazon-cloudwatch-agent.service.d"
    ignoreErrors: "false"

  03_remove_old_detach_override:
    command: "rm -f /etc/systemd/system/amazon-cloudwatch-agent.service.d/99-detach-from-eb.conf"
    ignoreErrors: "false"

  04_load_cloudwatch_config_and_start:
    command: "/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/tmp/amazon-cloudwatch-agent.json -s"
    ignoreErrors: "false"

  05_reload_enable_and_restart_cloudwatch_agent:
    command: "systemctl daemon-reload && systemctl enable amazon-cloudwatch-agent && systemctl restart amazon-cloudwatch-agent"
    ignoreErrors: "false"
